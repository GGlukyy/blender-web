+/* SPDX-FileCopyrightText: 2026 Blender Web port
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * No-op shader for the WebGPU backend skeleton: "compiles" everything successfully so that
+ * `GPU_init()` can finish. Real GLSL → SPIR-V → WGSL translation is milestone M9.
+ */
+
+#pragma once
+
+#include "gpu_shader_interface.hh"
+#include "gpu_shader_private.hh"
+
+namespace blender::gpu {
+
+class WebGPUShader : public Shader {
