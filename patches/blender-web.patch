diff --git a/build_files/cmake/platform/platform_wasm.cmake b/build_files/cmake/platform/platform_wasm.cmake
new file mode 100644
index 00000000..9d6b5030
--- /dev/null
+++ b/build_files/cmake/platform/platform_wasm.cmake
@@ -0,0 +1,125 @@
+# SPDX-FileCopyrightText: 2026 Blender Web port
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Platform configuration for Emscripten / WebAssembly (blender-web port).
+#
+# Libraries are NOT searched on the system. They come either from Emscripten ports
+# (zlib, SDL3) or from WASM_DEPS_PREFIX (built in milestone M4).
+# Run scripts/build_deps.sh first.
+
+# Prefix with wasm-built libraries (plain variable on purpose: a stale cached value is a trap).
+set(WASM_DEPS_PREFIX "${CMAKE_SOURCE_DIR}/../deps/wasm")
+get_filename_component(WASM_DEPS_PREFIX "${WASM_DEPS_PREFIX}" REALPATH)
+set(_inc "${WASM_DEPS_PREFIX}/include")
+set(_lib "${WASM_DEPS_PREFIX}/lib")
+set(WITH_STATIC_LIBS ON)
+file(MAKE_DIRECTORY "${WASM_DEPS_PREFIX}/include" "${WASM_DEPS_PREFIX}/lib" "${WASM_DEPS_PREFIX}/bin")
+
+# --- Emscripten ports -------------------------------------------------------
+set(EM_PORT_FLAGS "--use-port=zlib" "--use-port=sdl3")
+add_compile_options(${EM_PORT_FLAGS} -sMEMORY64=1)
+add_link_options(${EM_PORT_FLAGS} -sMEMORY64=1)
+set(_em_sysroot_inc "${EMSCRIPTEN_SYSROOT}/include")
+
+set(JPEG_FOUND TRUE)
+set(PNG_FOUND TRUE)
+set(ZLIB_FOUND TRUE)
+set(ZLIB_INCLUDE_DIRS "${_em_sysroot_inc}")
+set(ZLIB_LIBRARIES "")
+# FreeType comes from the prefix, NOT the Emscripten port: the port has no Brotli,
+# and Blender's UI fonts are WOFF2 (Brotli-compressed).
+set(FREETYPE_FOUND TRUE)
+set(FREETYPE_INCLUDE_DIRS "${_inc}/freetype2")
+set(FREETYPE_LIBRARIES "${_lib}/libfreetype.a")
+set(BROTLI_LIBRARIES "${_lib}/libbrotlidec.a" "${_lib}/libbrotlicommon.a")
+
+# --- Libraries built by scripts/build_deps.sh into WASM_DEPS_PREFIX -----------
+list(APPEND CMAKE_FIND_ROOT_PATH "${WASM_DEPS_PREFIX}")
+list(APPEND CMAKE_PREFIX_PATH "${WASM_DEPS_PREFIX}")
+
+# JPEG and PNG come from the prefix (libjpeg-turbo / libpng), NOT from the Emscripten ports,
+# so OpenImageIO and Blender link the same copy.
+set(JPEG_INCLUDE_DIR "${_inc}")
+set(JPEG_LIBRARIES "${_lib}/libjpeg.a")
+set(PNG_PNG_INCLUDE_DIR "${_inc}")
+set(PNG_INCLUDE_DIRS "${_inc}")
+set(PNG_LIBRARIES "${_lib}/libpng16.a")
+
+set(ZSTD_FOUND TRUE)
+set(ZSTD_INCLUDE_DIRS "${_inc}")
+set(ZSTD_LIBRARIES "${_lib}/libzstd.a")
+# Epoxy (OpenGL loader) is not used by the WebGPU backend.
+set(EPOXY_FOUND FALSE)
+set(EPOXY_INCLUDE_DIRS "")
+set(EPOXY_LIBRARIES "")
+
+find_package(Eigen3 REQUIRED CONFIG PATHS "${WASM_DEPS_PREFIX}/share/eigen3/cmake" NO_DEFAULT_PATH)
+find_package(fmt REQUIRED CONFIG)
+find_package(Imath REQUIRED CONFIG)
+find_package(OpenEXR REQUIRED CONFIG)
+find_package(OpenColorIO REQUIRED CONFIG)
+find_package(OpenImageIO REQUIRED CONFIG)
+set(SDL3_FOUND TRUE)
+if(NOT TARGET SDL3::SDL3)
+  add_library(SDL3::SDL3 INTERFACE IMPORTED)
+endif()
+if(NOT TARGET OpenImageIO::oiiotool)
+  # Only used to locate the tool for tests; we don't build it for wasm.
+  add_executable(OpenImageIO::oiiotool IMPORTED)
+  set_target_properties(OpenImageIO::oiiotool PROPERTIES IMPORTED_LOCATION "${WASM_DEPS_PREFIX}/bin/oiiotool")
+endif()
+
+# Host Python: only used to run build-time code generators (not the Python inside Blender).
+find_program(PYTHON_EXECUTABLE python3 NO_CMAKE_FIND_ROOT_PATH)
+
+# Python inside Blender: CPython built by scripts/build_python.sh (static, wasm64).
+# Everything is set explicitly: under the Emscripten toolchain find_path() is redirected to the sysroot.
+if(WITH_PYTHON)
+  set(PYTHON_VERSION "3.13" CACHE STRING "" FORCE)
+  set(PYTHON_INCLUDE_DIR "${_inc}/python3.13" CACHE PATH "" FORCE)
+  set(PYTHON_INCLUDE_CONFIG_DIR "${_inc}/python3.13" CACHE PATH "" FORCE)
+  set(PYTHON_LIBRARY "${_lib}/libpython3.13.a" CACHE FILEPATH "" FORCE)
+  set(PYTHON_LIBPATH "${_lib}" CACHE PATH "" FORCE)
+  set(PYTHON_LINKFLAGS "" CACHE STRING "" FORCE)
+  find_package(PythonLibsUnix REQUIRED)
+  # Modules compiled into libpython3.13.a need these side archives.
+  list(APPEND PYTHON_LIBRARIES "${_lib}/libpython3.13-mpdec.a" "${_lib}/libpython3.13-expat.a"
+       "${_lib}/libpython3.13-hacl.a")
+endif()
+
+# --- Threads, platform libs -------------------------------------------------
+list(APPEND PLATFORM_LINKLIBS -lm)
+find_package(Threads)
+if(CMAKE_THREAD_LIBS_INIT)
+  set(PTHREADS_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+endif()
+add_definitions(-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -D_LARGEFILE64_SOURCE)
+
+set(PLATFORM_CFLAGS "-pthread -sMEMORY64=1 -funsigned-char -fno-strict-aliasing")
+option(WITH_WASM_NODE_TARGET "Build executables to run in Node (headless, M5). OFF = browser build." ON)
+set(PLATFORM_LINKFLAGS "-pthread -sMEMORY64=1 -sPROXY_TO_PTHREAD -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=256MB -sMAXIMUM_MEMORY=4GB -sSTACK_SIZE=8MB -sDEFAULT_PTHREAD_STACK_SIZE=8MB")
+if(WITH_WASM_NODE_TARGET)
+  # Node with the real file system, so build-time tools (makesdna, datatoc, …) can write files.
+  set(PLATFORM_LINKFLAGS "${PLATFORM_LINKFLAGS} -sENVIRONMENT=node -sNODERAWFS=1 -sEXIT_RUNTIME=1")
+  # Build-time tools (datatoc, makesdna, …) are separate executables: they need it too.
+  add_link_options(-sENVIRONMENT=node -sNODERAWFS=1 -sEXIT_RUNTIME=1 -sALLOW_MEMORY_GROWTH=1)
+  # Emscripten emits a plain .js file; Blender's build runs generators directly, so
+  # add a shebang + exec bit after every executable link.
+  # wasm64 needs Node >= 24 (the one from emsdk), not the system Node.
+  if(DEFINED ENV{EMSDK_NODE})
+    set(_wasm_node "$ENV{EMSDK_NODE}")
+  else()
+    set(_wasm_node "/usr/bin/env node")
+  endif()
+  foreach(_lang C CXX)
+    set(CMAKE_${_lang}_LINK_EXECUTABLE
+      "${CMAKE_${_lang}_LINK_EXECUTABLE}"
+      "sh -c \"sed -i '1i #!${_wasm_node}' <TARGET> && chmod +x <TARGET>\""
+    )
+  endforeach()
+endif()
+
+unset(_inc)
+unset(_lib)
+unset(_em_sysroot_inc)
