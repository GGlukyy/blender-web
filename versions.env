# Pinned versions. The agent must NOT change these (see CLAUDE.md §1).
# Lukáš: when Blender 5.3 is out, check the exact tag name at
# https://projects.blender.org/blender/blender/tags and set it here ONCE.

BLENDER_TAG=v5.2.2
BLENDER_SERIES=5.2
BLENDER_GIT_URL=https://projects.blender.org/blender/blender.git

# Official desktop build, used only to create test scenes, reference images and to validate
# .blend files written by the web build. Check the exact file name on the download page.
DESKTOP_BLENDER_URL=https://download.blender.org/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz

# Emscripten SDK version. Pick the latest stable on the day you start and never change it
# mid-project without an ADR.
EMSDK_VERSION=6.0.12

NODE_VERSION=22
