+# SPDX-FileCopyrightText: 2026 Blender Web port
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Platform configuration for Emscripten / WebAssembly (blender-web port).
+#
+# Libraries are NOT searched on the system. They come either from Emscripten ports
+# (zlib, libpng, libjpeg, freetype) or from WASM_DEPS_PREFIX (built in milestone M4).
+# Until M4 is done the prefix may be empty: configure then succeeds with placeholder paths.
+
+set(WASM_DEPS_PREFIX "${CMAKE_BINARY_DIR}/wasm-deps" CACHE PATH "Prefix with wasm-built libraries")
+set(_inc "${WASM_DEPS_PREFIX}/include")
+set(_lib "${WASM_DEPS_PREFIX}/lib")
+set(WITH_STATIC_LIBS ON)
+file(MAKE_DIRECTORY "${WASM_DEPS_PREFIX}/include" "${WASM_DEPS_PREFIX}/lib" "${WASM_DEPS_PREFIX}/bin")
+
+# --- Emscripten ports -------------------------------------------------------
+set(EM_PORT_FLAGS "--use-port=zlib" "--use-port=libpng" "--use-port=libjpeg" "--use-port=freetype" "--use-port=sdl3")
+add_compile_options(${EM_PORT_FLAGS})
+add_link_options(${EM_PORT_FLAGS})
+set(_em_sysroot_inc "${EMSCRIPTEN_SYSROOT}/include")
+
+set(JPEG_FOUND TRUE)
+set(JPEG_INCLUDE_DIR "${_em_sysroot_inc}")
+set(JPEG_LIBRARIES "")
+set(PNG_FOUND TRUE)
+set(PNG_PNG_INCLUDE_DIR "${_em_sysroot_inc}")
+set(PNG_LIBRARIES "")
+set(PNG_INCLUDE_DIRS "${_em_sysroot_inc}")
+set(ZLIB_FOUND TRUE)
+set(ZLIB_INCLUDE_DIRS "${_em_sysroot_inc}")
+set(ZLIB_LIBRARIES "")
+set(FREETYPE_FOUND TRUE)
+set(FREETYPE_INCLUDE_DIRS "${_em_sysroot_inc}/freetype2")
+set(FREETYPE_LIBRARIES "")
+set(BROTLI_LIBRARIES "")
+
+# --- Libraries to be built in M4 (placeholders) -----------------------------
+set(ZSTD_FOUND TRUE)
+set(ZSTD_INCLUDE_DIRS "${_inc}")
+set(ZSTD_LIBRARIES "${_lib}/libzstd.a")
+set(EPOXY_FOUND TRUE)
+set(Epoxy_FOUND TRUE)
+set(EPOXY_INCLUDE_DIRS "${_inc}")
+set(EPOXY_LIBRARIES "")
+set(OPENEXR_FOUND TRUE)
+set(OPENEXR_INCLUDE_DIRS "${_inc}")
+set(OPENEXR_LIBRARIES "")
+set(OPENIMAGEIO_FOUND TRUE)
+set(OPENIMAGEIO_INCLUDE_DIRS "${_inc}")
+set(OPENIMAGEIO_LIBRARIES "")
+set(OPENCOLORIO_FOUND TRUE)
+set(OPENCOLORIO_INCLUDE_DIRS "${_inc}")
+set(OPENCOLORIO_LIBRARIES "")
+set(EIGEN3_FOUND TRUE)
+set(EIGEN3_INCLUDE_DIRS "${_inc}/eigen3")
+set(EIGEN3_INCLUDE_DIR "${_inc}/eigen3")
+
+# fmt is header-only usable; provide it as an interface target.
+if(NOT TARGET fmt::fmt)
+  add_library(fmt::fmt INTERFACE IMPORTED)
+  set_target_properties(fmt::fmt PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
+endif()
+
+# Imported targets that dependency_targets.cmake aliases. M4 replaces these with real libraries.
+foreach(_t Eigen3::Eigen SDL3::SDL3)
+  if(NOT TARGET ${_t})
+    add_library(${_t} INTERFACE IMPORTED)
+  endif()
+endforeach()
+set_target_properties(Eigen3::Eigen PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${WASM_DEPS_PREFIX}/include")
+set(SDL3_FOUND TRUE)
+
+foreach(_t OpenColorIO::OpenColorIO OpenImageIO::OpenImageIO OpenEXR::OpenEXR)
+  if(NOT TARGET ${_t})
+    add_library(${_t} INTERFACE IMPORTED)
+    set_target_properties(${_t} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${WASM_DEPS_PREFIX}/include")
+  endif()
+endforeach()
+if(NOT TARGET OpenImageIO::oiiotool)
+  add_executable(OpenImageIO::oiiotool IMPORTED)
+  set_target_properties(OpenImageIO::oiiotool PROPERTIES IMPORTED_LOCATION "${WASM_DEPS_PREFIX}/bin/oiiotool")
+endif()
+
+# --- Threads, platform libs -------------------------------------------------
+list(APPEND PLATFORM_LINKLIBS -lm)
+find_package(Threads)
+if(CMAKE_THREAD_LIBS_INIT)
+  set(PTHREADS_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+endif()
+add_definitions(-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -D_LARGEFILE64_SOURCE)
+
+set(PLATFORM_CFLAGS "-pthread -funsigned-char -fno-strict-aliasing")
+set(PLATFORM_LINKFLAGS "-pthread -sPROXY_TO_PTHREAD -sALLOW_MEMORY_GROWTH=1 -sMAXIMUM_MEMORY=4GB")
+
+unset(_inc)
+unset(_lib)
+unset(_em_sysroot_inc)
