+/* SPDX-FileCopyrightText: 2026 Blender Web port
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WebGPU backend (blender-web port). SKELETON (M8.2): behaves like the dummy backend, but reports
+ * itself as `GPU_BACKEND_WEBGPU`. The device, surface and real resources come in M8.3+.
+ * See docs/decisions/0004-webgpu-main-loop.md.
+ */
+
+#pragma once
+
+#include "dummy_backend.hh"
+#include "gpu_capabilities_private.hh"
+#include "gpu_shader_private.hh"
+#include "wgpu_buffers.hh"
+#include "wgpu_shader.hh"
+
+namespace blender::gpu {
+
+class WebGPUBackend : public DummyBackend {
+ public:
+  WebGPUBackend()
+  {
+    GPG.init(GPU_DEVICE_ANY,
+             GPU_OS_ANY,
+             GPU_DRIVER_ANY,
+             GPU_SUPPORT_LEVEL_SUPPORTED,
+             GPU_BACKEND_WEBGPU,
+             "WebGPU",
+             "",
+             "",
+             GPU_ARCHITECTURE_IMR);
+  }
+
+  void init_resources() override
+  {
+    /* Compile on the calling thread (no worker threads, no extra GPU contexts). */
+    GCaps.use_main_context_workaround = true;
+    compiler_ = MEM_new<ShaderCompiler>(__func__, 1, GPUWorker::ContextType::Main);
+  }
+  void delete_resources() override
+  {
+    MEM_delete(compiler_);
+    compiler_ = nullptr;
+  }
+  Shader *shader_alloc(const char *name) override
+  {
+    return new WebGPUShader(name);
+  }
+  UniformBuf *uniformbuf_alloc(size_t size, const char *name) override
+  {
+    return new WebGPUUniformBuf(size, name);
+  }
+  StorageBuf *storagebuf_alloc(size_t size, GPUUsageType /*usage*/, const char *name) override
+  {
+    return new WebGPUStorageBuf(size, name);
+  }
+
+  static bool is_supported()
+  {
+    return true;
+  }
+};
+
+}  // namespace blender::gpu
