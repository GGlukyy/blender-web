+/* SPDX-FileCopyrightText: 2026 Blender Web port
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * No-op storage / uniform buffers for the WebGPU backend skeleton (M8.2/M8.3). They only keep a
+ * CPU copy so that code which updates them does not crash. Real GPU buffers come later.
+ */
+
+#pragma once
+
+#include <cstring>
+
+#include "MEM_guardedalloc.h"
+
+#include "gpu_storage_buffer_private.hh"
+#include "gpu_uniform_buffer_private.hh"
+
+namespace blender::gpu {
+
+class WebGPUStorageBuf : public StorageBuf {
+ public:
+  WebGPUStorageBuf(size_t size, const char *name) : StorageBuf(size, name) {}
+  void update(const void * /*data*/) override {}
+  void bind(int /*slot*/) override {}
+  void unbind() override {}
+  void clear(uint32_t /*clear_value*/) override {}
+  void copy_sub(VertBuf * /*src*/,
+                uint /*dst_offset*/,
+                uint /*src_offset*/,
+                uint /*copy_size*/) override
+  {
+  }
+  void read(void *data) override
+  {
+    memset(data, 0, size_in_bytes_);
+  }
+  void async_flush_to_host() override {}
+  void sync_as_indirect_buffer() override {}
+};
+
+class WebGPUUniformBuf : public UniformBuf {
+ public:
+  WebGPUUniformBuf(size_t size, const char *name) : UniformBuf(size, name) {}
+  void update(const void * /*data*/) override {}
+  void clear_to_zero() override {}
+  void bind(int /*slot*/) override {}
+  void bind_as_ssbo(int /*slot*/) override {}
+  void unbind() override {}
+};
+
+}  // namespace blender::gpu
